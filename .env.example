# Application database. Use a MongoDB Replica Set or MongoDB Atlas in Production.
MONGODB_URL=mongodb://127.0.0.1:27017/commute-tracker?replicaSet=rs0

# Better Auth server-only secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Exact public origin used by the application.
BETTER_AUTH_URL=http://localhost:3000

# Required only when running scripts/bootstrap-owner.ts from a terminal.
AUTH_BOOTSTRAP_CONFIRM=CREATE_SINGLE_OWNER

